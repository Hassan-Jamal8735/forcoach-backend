# Copy to `.env` on the VPS and fill in real values. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# --- Domains --------------------------------------------------------------
SITE_DOMAIN=forcoach.io
API_DOMAIN=api.forcoach.io
SUPABASE_DOMAIN=db.forcoach.io
ACME_EMAIL=contact@forcoach.io

# --- Public URLs (must match the domains above) ---------------------------
NEXT_PUBLIC_SITE_URL=https://forcoach.io
NEXT_PUBLIC_API_URL=https://api.forcoach.io
NEXT_PUBLIC_SUPABASE_URL=https://db.forcoach.io

# --- Supabase secrets -----------------------------------------------------
# JWT_SECRET: 40+ char random string. ANON_KEY / SERVICE_ROLE_KEY are JWTs
# signed with it — generate at https://supabase.com/docs/guides/self-hosting/docker
# (the "Generate API keys" section) or with the supabase CLI.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

POSTGRES_PASSWORD=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Google OAuth ---------------------------------------------------------
# Same Google Cloud project as before. Both redirect URIs below must be
# registered in the Google Console before cutover.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used by our own Calendar-read integration (NestJS backend):
GOOGLE_REDIRECT_URI=https://api.forcoach.io/auth/google/callback
# Supabase GoTrue's own callback (for Google sign-in) will be:
#   https://db.forcoach.io/auth/v1/callback

# --- SMTP -----------------------------------------------------------------
# REQUIRED. Used by BOTH self-hosted Supabase auth (password resets, email
# confirmations) and the NestJS backend (new-signup notifications). On
# Supabase cloud these emails were sent for us; self-hosted, they silently
# fail without working SMTP. Reuse the same mailbox the backend uses today.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_SENDER_NAME=FORCOACH
SMTP_ADMIN_EMAIL=contact@forcoach.io
